<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sending info via id</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h2>  Here is your content in detail</h2>
        <p class="=id"> Post id: <%=post.id %> </p>
        <div class="post">
            <h3 class="user">@<%= post.username %></h3>
            <h3 class="content"><%= post.content %></h3>
        </div>
    
    
</body>
</html>